{
  "name": "doujin-scraper",
  "version": "1.0.1",
  "description": "Standalone data-collection modules for manga / video cataloging sources. Zero-dependency ESM, runs on Node.js >= 18.17, Bun, Deno, or any JS runtime with global fetch.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./doujindesu": "./src/doujindesu.js",
    "./nekopoi": "./src/nekopoi.js",
    "./hentaitv": "./src/hentaitv.js",
    "./eporner": "./src/eporner.js",
    "./cache": "./src/cache.js",
    "./security": "./src/security.js",
    "./proxy": "./src/proxy.js",
    "./rate-limiter": "./src/rate-limiter.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev:web": "vite src/web",
    "build:web": "vite build",
    "start": "node server.js",
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "example": "node examples/basic.js"
  },
  "keywords": [
    "scraper",
    "doujin",
    "hentai",
    "doujindesu",
    "nekopoi",
    "hentaitv",
    "eporner",
    "web-scraping",
    "api-wrapper",
    "nodejs",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "Hengki <henkii@henkii.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyy0887/doujin-scraper"
  },
  "bugs": {
    "url": "https://github.com/kyy0887/doujin-scraper/issues"
  },
  "homepage": "https://github.com/kyy0887/doujin-scraper#readme",
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "express": "^5.2.1",
    "lucide-vue-next": "^1.0.0",
    "undici": "^8.10.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.0"
  }
}
