# DOUJIN SCRAPER — Environment Configuration
# Copy this file to .env and fill in the secrets.

# ── Doujindesu ───────────────────────────────────────────────────
# REQUIRED: app secret and salt from the doujin source site.
DOUJIN_APP_SECRET=
DOUJIN_SALT=
# Optional overrides
DOUJIN_BASE_URL=https://doujin.desu.xxx
DOUJIN_USER_AGENT=Mozilla/5.0 ...
DOUJIN_TIMEOUT_MS=30000

# ── NekoPoi ──────────────────────────────────────────────────────
# NEKO_BASE_URL=https://nekopoi.care
# NEKO_TIMEOUT_MS=30000

# ── Hentai.tv ────────────────────────────────────────────────────
# HENTAI_BASE_URL=https://hentai.tv
# HENTAI_TIMEOUT_MS=30000

# ── Eporner ──────────────────────────────────────────────────────
# EPORNER_BASE_URL=https://www.eporner.com
# EPORNER_API_BASE=https://api.eporner.com/api/v2

# Naikkan karena warm-up proxy bisa sampai 60 detik
# EPORNER_TIMEOUT_MS=90000

# Mode: direct | manual | auto
# EPORNER_PROXY_MODE=auto
# EPORNER_PROXY_PROVIDERS=proxmint,proxyscrape,speedx,monosans,proxifly

# Kalau semua proxy gagal, coba koneksi langsung
# EPORNER_PROXY_FALLBACK=direct

# ── Tuning proxy (opsional, ini nilai default) ───────────────────
# PROXY_PROBE_CONCURRENCY=60
# PROXY_PROBE_TIMEOUT=6000
# PROXY_WARMUP_BUDGET=60000
# PROXY_MIN_GOOD=3
# PROXY_TIMEOUT=10000
# PROXY_CONCURRENCY=3
# ROXY_BAD_COOLDOWN=600000

# Matikan (0) supaya log tidak banjir; ubah ke 1 kalau perlu debug
# PROXY_DEBUG=0

# Chace
# PROXY_CACHE_FILE=.proxy-cache.json